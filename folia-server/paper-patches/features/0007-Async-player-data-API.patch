Subject: [PATCH] Expose asynchronous player data persistence

---
 src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java b/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
index aba936a53..04b47c515 100644
--- a/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
+++ b/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
@@ -1387,6 +1387,11 @@ public class CraftPlayer extends CraftHumanEntity implements Player, PluginMessa
         this.server.getHandle().playerIo.save(this.getHandle());
     }
 
+    @Override
+    public java.util.concurrent.CompletableFuture<Void> saveDataAsync() {
+        return this.server.getHandle().playerIo.saveAsync(this.getHandle());
+    }
+
     @Deprecated
     @Override
     public void updateInventory() {
