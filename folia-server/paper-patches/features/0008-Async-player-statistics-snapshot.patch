diff --git a/src/main/java/org/bukkit/craftbukkit/CraftStatistic.java b/src/main/java/org/bukkit/craftbukkit/CraftStatistic.java
index d1a45c200..c2f30b1e5 100644
--- a/src/main/java/org/bukkit/craftbukkit/CraftStatistic.java
+++ b/src/main/java/org/bukkit/craftbukkit/CraftStatistic.java
@@ -144,6 +144,43 @@ public enum CraftStatistic {
         return statistics.get(nmsKey);
     }
 
+    public static java.util.concurrent.CompletableFuture<java.util.Map<Statistic, Integer>> getStatisticsAsync(
+        CraftServer server, com.mojang.authlib.GameProfile profile, java.util.Set<Statistic> statistics
+    ) {
+        java.util.Set<Statistic> requested = java.util.Set.copyOf(statistics);
+        requested.forEach(statistic -> Preconditions.checkArgument(statistic.getType() == Type.UNTYPED, "This method only accepts untyped statistics"));
+        if (requested.isEmpty()) return java.util.concurrent.CompletableFuture.completedFuture(java.util.Map.of());
+        java.util.concurrent.CompletableFuture<java.util.Map<Statistic, Integer>> result = new java.util.concurrent.CompletableFuture<>();
+        Runnable readOffline = () -> server.getHandle().getPlayerStatsAsync(profile, false).whenComplete((counter, failure) -> {
+            if (failure != null) result.completeExceptionally(failure);
+            else {
+                try {
+                    result.complete(snapshot(counter, requested));
+                } catch (Exception error) {
+                    result.completeExceptionally(error);
+                }
+            }
+        });
+        ServerPlayer online = server.getHandle().getPlayer(profile.id());
+        if (online == null) {
+            readOffline.run();
+        } else if (!online.getBukkitEntity().taskScheduler.schedule(entity -> {
+            try {
+                result.complete(snapshot(((ServerPlayer) entity).getStats(), requested));
+            } catch (Exception failure) {
+                result.completeExceptionally(failure);
+            }
+        }, entity -> readOffline.run(), 1L)) {
+            readOffline.run();
+        }
+        return result;
+    }
+
+    private static java.util.Map<Statistic, Integer> snapshot(ServerStatsCounter counter, java.util.Set<Statistic> requested) {
+        java.util.Map<Statistic, Integer> values = new java.util.EnumMap<>(Statistic.class);
+        requested.forEach(statistic -> values.put(statistic, getStatistic(counter, statistic)));
+        return java.util.Map.copyOf(values);
+    }
     public static net.minecraft.stats.Stat getNMSStatistic(org.bukkit.Statistic bukkit) {
         Preconditions.checkArgument(bukkit.getType() == Statistic.Type.UNTYPED, "This method only accepts untyped statistics");
 
