+            Path directory = this.playerDir.toPath();
+            Path temporary = Files.createTempFile(directory, id + "-", ".dat");
+            try {
+                NbtIo.writeCompressed(snapshot, temporary);
+                Path current = directory.resolve(id + ".dat");
+                if (!Util.safeReplaceOrMoveFile(current, temporary, directory.resolve(id + ".dat_old"), false)) {
+                    throw new IOException("Failed to replace player data for " + id);
+                }
+                if (!snapshot.equals(NbtIo.readCompressed(current, NbtAccounter.unlimitedHeap()))) {
+                    throw new IOException("Player data verification failed for " + id);
+                }
+                return null;
+            } finally {
+                Files.deleteIfExists(temporary);
+            }
+        });
+    }
