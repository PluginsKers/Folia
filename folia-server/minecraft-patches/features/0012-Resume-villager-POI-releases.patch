     // Paper start - rewrite chunk system
     private final net.minecraft.server.level.ServerLevel world;
+    private static final org.slf4j.Logger RELEASE_LOGGER = com.mojang.logging.LogUtils.getLogger();
+    private final java.util.Set<PendingRelease> pendingReleases = java.util.concurrent.ConcurrentHashMap.newKeySet();
 
