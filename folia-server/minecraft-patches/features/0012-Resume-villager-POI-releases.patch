@@ -1173,6 +1173,79 @@ public final class ChunkHolderManager {
         return null;
     }
 
+    public PoiChunkLease acquirePoiChunk(final int chunkX, final int chunkZ) {
+        final PoiChunkLease lease = new PoiChunkLease(chunkX, chunkZ);
+        try {
+            final ReentrantAreaLock.Node ticketLock = this.ticketLockArea.lock(chunkX, chunkZ);
+            try {
+                this.addTicketAtLevel(ChunkTaskScheduler.POI_LOAD, chunkX, chunkZ, MAX_TICKET_LEVEL, lease.id);
+                final ReentrantAreaLock.Node schedulingLock = this.taskScheduler.schedulingLockArea.lock(chunkX, chunkZ);
+                try {
+                    final NewChunkHolder holder = this.getOrCreateChunkHolder(chunkX, chunkZ);
+                    final PoiChunk loaded = holder.getPoiChunk();
+                    if (loaded != null) {
+                        lease.ready.complete(loaded);
+                    } else {
+                        lease.task = holder.getOrLoadPoiData(result -> {
+                            if (result.right() != null) lease.ready.completeExceptionally(result.right());
+                            else lease.ready.complete(result.left());
+                        });
+                    }
+                } finally {
+                    this.taskScheduler.schedulingLockArea.unlock(schedulingLock);
+                }
+            } finally {
+                this.ticketLockArea.unlock(ticketLock);
+            }
+            if (lease.task != null) lease.task.schedule();
+            return lease;
+        } catch (final Throwable failure) {
+            try {
+                lease.close();
+            } catch (final Throwable cleanupFailure) {
+                failure.addSuppressed(cleanupFailure);
+            }
+            throw failure;
+        }
+    }
+
+    public final class PoiChunkLease implements AutoCloseable {
+        private final int chunkX, chunkZ;
+        private final Long id = ChunkTaskScheduler.getNextPoiLoadId();
+        private final AtomicBoolean closed = new AtomicBoolean();
+        private final java.util.concurrent.CompletableFuture<PoiChunk> ready = new java.util.concurrent.CompletableFuture<>();
+        private NewChunkHolder.GenericDataLoadTaskCallback task;
+
+        private PoiChunkLease(final int chunkX, final int chunkZ) {
+            this.chunkX = chunkX;
+            this.chunkZ = chunkZ;
+        }
+
+        // Loading the result into the world and accessing its sections still require the owning region.
+        public PoiChunk getIfReady() {
+            if (this.closed.get()) throw new IllegalStateException("POI lease is closed");
+            return this.ready.getNow(null);
+        }
+
+        public boolean isReady() {
+            return this.ready.isDone();
+        }
+
+        public void whenReady(final Runnable action) {
+            this.ready.whenComplete((chunk, failure) -> action.run());
+        }
+
+        @Override
+        public void close() {
+            if (!this.closed.compareAndSet(false, true)) return;
+            try {
+                if (this.task != null) this.task.cancel();
+            } finally {
+                ChunkHolderManager.this.removeTicketAtLevel(ChunkTaskScheduler.POI_LOAD, this.chunkX, this.chunkZ, MAX_TICKET_LEVEL, this.id);
+            }
+        }
+    }
+
     public PoiChunk loadPoiChunk(final int chunkX, final int chunkZ) {
         TickThread.ensureTickThread(this.world, chunkX, chunkZ, "Cannot create poi chunk off-main");
         PoiChunk ret;
