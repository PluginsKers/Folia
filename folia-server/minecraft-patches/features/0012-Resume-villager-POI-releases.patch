+    /** Accepts one release, independent of the entity's subsequent memory or lifetime. */
+    public void releaseWhenLoaded(final BlockPos position, final Predicate<Holder<PoiType>> predicate, final boolean updateWhenAbsent) {
+        final BlockPos pos = position.immutable();
+        final int chunkX = pos.getX() >> 4, chunkZ = pos.getZ() >> 4;
+        final var queue = io.papermc.paper.threadedregions.RegionizedServer.getInstance().taskQueue;
+        if (this.world.isOutsideBuildHeight(pos)) {
+            if (updateWhenAbsent) queue.queueOrExecuteTickTask(this.world, chunkX, chunkZ, () -> this.world.debugSynchronizers().updatePoi(pos));
+            return;
+        }
+        final var manager = this.world.moonrise$getChunkTaskScheduler().chunkHolderManager;
+        final boolean ownsRegion = io.papermc.paper.threadedregions.TickRegionScheduler.getCurrentRegion() != null
+            && ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(this.world, chunkX, chunkZ);
+        if (ownsRegion
+            && manager.getPoiChunkIfLoaded(chunkX, chunkZ, true) != null) {
+            this.releaseMatching(pos, predicate, updateWhenAbsent);
+            return;
+        }
+
+        final var lease = manager.acquirePoiChunk(chunkX, chunkZ);
+        final PendingRelease pending;
+        try {
+            pending = new PendingRelease(pos, predicate, updateWhenAbsent, lease);
+            this.pendingReleases.add(pending);
+        } catch (final Throwable failure) {
+            try {
+                lease.close();
+            } catch (final Throwable cleanupFailure) {
+                failure.addSuppressed(cleanupFailure);
+            }
+            throw failure;
+        }
+        if (lease.isReady() && ownsRegion) {
+            pending.task.execute();
+        } else {
+            lease.whenReady(pending::queue);
+        }
+    }
+
+    private void releaseMatching(final BlockPos pos, final Predicate<Holder<PoiType>> predicate, final boolean updateWhenAbsent) {
+        final boolean matches = this.getType(pos).filter(predicate).isPresent();
+        if (matches) this.release(pos);
+        if (matches || updateWhenAbsent) this.world.debugSynchronizers().updatePoi(pos);
+    }
+
+    // Wait before halting the load executor: halting it does not execute queued POI parsing tasks.
+    public void awaitPendingReleases(final long deadlineNanos) {
+        if (!ca.spottedleaf.moonrise.common.util.TickThread.isShutdownThread()) throw new IllegalStateException("Waiting for POI releases outside shutdown");
+        for (final PendingRelease pending : this.pendingReleases) {
+            try {
+                // The handoff includes queueing its region task, not only completing the disk read.
+                pending.dispatched.get(Math.max(0L, deadlineNanos - System.nanoTime()), java.util.concurrent.TimeUnit.NANOSECONDS);
+            } catch (final Exception failure) {
+                if (failure instanceof InterruptedException) Thread.currentThread().interrupt();
+                try {
+                    pending.cancel();
+                } catch (final Throwable cleanupFailure) {
+                    failure.addSuppressed(cleanupFailure);
+                }
+                RELEASE_LOGGER.error("POI release did not reach its region before shutdown at {}", pending.pos, failure);
+            }
+        }
+    }
+
+    // Called in the existing shutdown region scope immediately before saving that region.
+    public void finishPendingReleases() {
+        if (!ca.spottedleaf.moonrise.common.util.TickThread.isShutdownThread()
+            || io.papermc.paper.threadedregions.TickRegionScheduler.getCurrentRegion() == null) {
+            throw new IllegalStateException("Draining POI releases outside a shutdown region");
+        }
+        for (final PendingRelease pending : this.pendingReleases) {
+            if (!ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(this.world, pending.pos)) continue;
+            try {
+                pending.task.execute();
+            } catch (final Throwable failure) {
+                RELEASE_LOGGER.error("Failed to release POI before saving at {}", pending.pos, failure);
+            }
+        }
+    }
+
+    private final class PendingRelease {
+        private final BlockPos pos;
+        private final Predicate<Holder<PoiType>> predicate;
+        private final boolean updateWhenAbsent;
+        private final ca.spottedleaf.moonrise.patches.chunk_system.scheduling.ChunkHolderManager.PoiChunkLease lease;
+        private final ca.spottedleaf.concurrentutil.executor.PrioritisedExecutor.PrioritisedTask task;
+        private final java.util.concurrent.CompletableFuture<Void> dispatched = new java.util.concurrent.CompletableFuture<>();
+
+        private PendingRelease(final BlockPos pos, final Predicate<Holder<PoiType>> predicate, final boolean updateWhenAbsent,
+                               final ca.spottedleaf.moonrise.patches.chunk_system.scheduling.ChunkHolderManager.PoiChunkLease lease) {
+            this.pos = pos;
+            this.predicate = predicate;
+            this.updateWhenAbsent = updateWhenAbsent;
+            this.lease = lease;
+            this.task = io.papermc.paper.threadedregions.RegionizedServer.getInstance().taskQueue
+                .createTickTaskQueue(PoiManager.this.world, pos.getX() >> 4, pos.getZ() >> 4, this::run);
+        }
+
+        private void queue() {
+            try {
+                this.task.queue();
+                this.dispatched.complete(null);
+            } catch (final Throwable failure) {
+                try {
+                    this.cancel();
+                } catch (final Throwable cleanupFailure) {
+                    failure.addSuppressed(cleanupFailure);
+                }
+                this.dispatched.completeExceptionally(failure);
+                RELEASE_LOGGER.error("Failed to schedule POI release at {}", this.pos, failure);
+            }
+        }
+
+        private void run() {
+            try {
+                ca.spottedleaf.moonrise.common.util.TickThread.ensureTickThread(PoiManager.this.world, this.pos, "Releasing POI off owner");
+                final var chunk = this.lease.getIfReady();
+                if (chunk == null) throw new IllegalStateException("POI release ran before its read completed");
+                chunk.load();
+                PoiManager.this.releaseMatching(this.pos, this.predicate, this.updateWhenAbsent);
+            } finally {
+                this.close();
+            }
+        }
+
+        private void cancel() {
+            if (this.task.cancel()) this.close();
+        }
+
+        private void close() {
+            try {
+                this.lease.close();
+            } finally {
+                PoiManager.this.pendingReleases.remove(this);
+            }
+        }
+    }
+
     public boolean exists(final BlockPos pos, final Predicate<Holder<PoiType>> predicate) {
         return this.getOrLoad(SectionPos.asLong(pos)).map(s -> s.exists(pos, predicate)).orElse(false);
     }
