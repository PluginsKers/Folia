+    public static boolean tryRunEntityRemoval(final Entity entity, final Runnable removal) {
+        if (!(Thread.currentThread() instanceof RegionShutdownThread shutdownThread)) {
+            return false;
+        }
+        shutdownThread.runEntityRemoval(entity, removal);
+        return true;
+    }
+
+    public static boolean tryRunTickTask(final ServerLevel world, final int chunkX, final int chunkZ, final Runnable task) {
+        if (!(Thread.currentThread() instanceof RegionShutdownThread shutdownThread)) {
+            return false;
+        }
+        shutdownThread.runTickTask(world, chunkX, chunkZ, task);
+        return true;
+    }
+
+    void runEntityRemoval(final Entity entity, final Runnable removal) {
+        this.requireHaltedScheduler();
+        if (entity.hasInactiveLevelCallback()) {
+            this.runInRegion(null, removal);
+            return;
+        }
+        final int sectionX = entity.moonrise$getSectionX();
+        final int sectionZ = entity.moonrise$getSectionZ();
+        if (sectionX == Integer.MIN_VALUE || sectionZ == Integer.MIN_VALUE || !(entity.level() instanceof ServerLevel world)) {
+            throw new IllegalStateException("Cannot remove an entity without its registered region during shutdown");
+        }
+        final var region = world.regioniser.getRegionAtSynchronised(sectionX, sectionZ);
+        if (region == null) {
+            throw new IllegalStateException("Cannot find the entity's registered region during shutdown");
+        }
+        this.runInRegion(region, () -> {
+            final RegionizedWorldData worldData = region.getData().getRegionizedData(world.worldRegionData);
+            if (worldData == null || !worldData.hasEntity(entity)) {
+                throw new IllegalStateException("Entity does not belong to its registered region during shutdown");
+            }
+            removal.run();
+        });
+    }
+
+    void runTickTask(final ServerLevel world, final int chunkX, final int chunkZ, final Runnable task) {
+        this.requireHaltedScheduler();
+        // A synchronized lookup distinguishes an absent region from an in-progress merge or split.
+        // Truly absent regions retain the shutdown thread's existing inline, null-context behavior.
+        this.runInRegion(world.regioniser.getRegionAtSynchronised(chunkX, chunkZ), task);
+    }
+
+    private void requireHaltedScheduler() {
+        if (!this.schedulerHalted) {
+            throw new IllegalStateException("Cannot borrow a region before the tick scheduler has terminated");
+        }
+    }
+
+    private void runInRegion(final ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData> region,
+                             final Runnable action) {
+        final var previous = this.shuttingDown;
+        final boolean acquire = region != null && !this.borrowedRegions.contains(region);
+        if (acquire) {
+            // Chunk I/O and plugin tasks can still create regions after tick workers stop. Hold the existing
+            // region lease so that they defer migration until this operation has finished; never wait for it.
+            if (!region.tryMarkTicking(() -> false)) {
+                throw new IllegalStateException("Cannot borrow a busy or retired region during shutdown");
+            }
+            this.borrowedRegions.add(region);
+        }
+        try {
+            this.shuttingDown = region;
+            action.run();
+        } finally {
+            this.shuttingDown = null;
+            try {
+                if (acquire) {
+                    this.borrowedRegions.remove(this.borrowedRegions.size() - 1);
+                    region.markNotTicking();
+                }
+            } finally {
+                this.shuttingDown = previous;
+            }
+        }
+    }
+
     // The region shutdown thread bypasses all tick thread checks, which will allow us to execute global saves
     // it will not however let us perform arbitrary sync loads, arbitrary world state lookups simply because
     // the data required to do that is regionised, and we can only access it when we OWN the region, and we do not.
@@ -154,7 +237,7 @@ public final class RegionShutdownThread extends ca.spottedleaf.moonrise.common.u
     public final void run() {
