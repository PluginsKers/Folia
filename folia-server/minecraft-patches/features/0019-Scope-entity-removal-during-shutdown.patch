         LOGGER.info("Awaiting scheduler termination for 60s...");
-        final boolean schedulerHalted = TickRegions.getScheduler().halt(true, TimeUnit.SECONDS.toNanos(60L));
+        final boolean schedulerHalted = this.schedulerHalted = TickRegions.getScheduler().halt(true, TimeUnit.SECONDS.toNanos(60L));
         if (schedulerHalted) {
             LOGGER.info("Scheduler halted");
         } else {
