+package ca.spottedleaf.moonrise.patches.poi_lookup;
+
+import ca.spottedleaf.moonrise.common.util.CoordinateUtils;
+import ca.spottedleaf.moonrise.common.util.TickThread;
+import ca.spottedleaf.moonrise.patches.chunk_system.level.ChunkSystemServerLevel;
+import ca.spottedleaf.moonrise.patches.chunk_system.level.poi.PoiChunk;
+import ca.spottedleaf.moonrise.patches.chunk_system.scheduling.ChunkHolderManager;
+import it.unimi.dsi.fastutil.longs.Long2ObjectOpenHashMap;
+import java.util.List;
+import java.util.Optional;
+import java.util.function.Consumer;
+import java.util.function.Predicate;
+import net.minecraft.core.BlockPos;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.util.Util;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.entity.Mob;
+import net.minecraft.world.entity.ai.village.poi.PoiRecord;
+import net.minecraft.world.entity.ai.village.poi.PoiSection;
+
+/** Resumes a POI cursor on its entity owner while retaining exactly the chunks it has visited. */
+public final class PoiSearchTask {
+    private final Mob body;
+    private final ServerLevel level;
+    private final BlockPos origin;
+    private final net.minecraft.world.entity.ai.Brain<?> brain;
+    private final PoiAccess.Search search;
+    private final Predicate<Mob> valid;
+    private final Consumer<List<PoiRecord>> complete;
+    private final Runnable finished;
+    private final ChunkHolderManager manager;
+    private final Long2ObjectOpenHashMap<ChunkHolderManager.PoiChunkLease> leases = new Long2ObjectOpenHashMap<>();
+
+    private PoiSearchTask(final Mob body, final PoiAccess.Search search, final Predicate<Mob> valid,
+                          final Consumer<List<PoiRecord>> complete, final Runnable finished) {
+        this.body = body;
+        this.level = (ServerLevel)body.level();
+        this.origin = body.blockPosition().immutable();
+        this.brain = body.getBrain();
+        this.search = search;
+        this.valid = valid;
+        this.complete = complete;
+        this.finished = finished;
+        this.manager = ((ChunkSystemServerLevel)this.level).moonrise$getChunkTaskScheduler().chunkHolderManager;
+    }
+
+    public static void start(final Mob body, final PoiAccess.Search search, final Predicate<Mob> valid,
+                             final Consumer<List<PoiRecord>> complete, final Runnable finished) {
+        TickThread.ensureTickThread(body, "Starting POI search off owner");
+        new PoiSearchTask(body, search, valid, complete, finished).run(body);
+    }
+
+    private void run(final Entity current) {
+        boolean waiting = false;
+        try {
+            if (current != this.body || !current.isAlive() || current.isRemoved() || current.level() != this.level
+                || this.body.isNoAi() || this.body.getBrain() != this.brain
+                || !current.blockPosition().equals(this.origin) || !this.valid.test(this.body)) return;
+            // A region may split or the entity may transfer while an IO request is pending.
+            for (final long key : this.leases.keySet()) {
+                if (!TickThread.isTickThreadFor(this.level, CoordinateUtils.getChunkX(key), CoordinateUtils.getChunkZ(key))) return;
+            }
+            if (this.search.advance(this::section)) {
+                this.complete.accept(this.search.result());
+            } else {
+                waiting = this.body.getBukkitEntity().taskScheduler.schedule(this::run, ignored -> this.retired(), 1L);
+            }
+        } catch (final LostOwnership ignored) {
+            // Retry from the entity's current region on the next normal AI attempt.
+        } finally {
+            if (!waiting) {
+                try {
+                    this.close();
+                } finally {
+                    this.finished.run();
+                }
+            }
+        }
+    }
+
+    private Optional<PoiSection> section(final long sectionKey) {
+        final int x = CoordinateUtils.getChunkSectionX(sectionKey);
+        final int z = CoordinateUtils.getChunkSectionZ(sectionKey);
+        if (!TickThread.isTickThreadFor(this.level, x, z)) throw new LostOwnership();
+        final long chunkKey = CoordinateUtils.getChunkKey(x, z);
+        ChunkHolderManager.PoiChunkLease lease = this.leases.get(chunkKey);
+        if (lease == null) {
+            lease = this.manager.acquirePoiChunk(x, z);
+            this.leases.put(chunkKey, lease);
+        }
+        final PoiChunk chunk = lease.getIfReady();
+        if (chunk == null) return null;
+        chunk.load();
+        return chunk.getSectionForVanilla(CoordinateUtils.getChunkSectionY(sectionKey));
+    }
+
+    private void retired() {
+        // Entity retirement runs inside entity removal; ticket changes must happen outside that critical section.
+        Util.ioPool().execute(this::close);
+    }
+
+    private void close() {
+        Throwable failure = null;
+        for (final ChunkHolderManager.PoiChunkLease lease : this.leases.values()) {
+            try {
+                lease.close();
+            } catch (final Throwable caught) {
+                if (failure == null) failure = caught;
+                else failure.addSuppressed(caught);
+            }
+        }
+        this.leases.clear();
+        if (failure != null) throw new IllegalStateException("Failed to release POI search leases", failure);
+    }
+
+    private static final class LostOwnership extends RuntimeException {
+        private LostOwnership() { super(null, null, false, false); }
+    }
+}
