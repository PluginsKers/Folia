+    public void cancelCatSpawn(final boolean underRegionLock) {
+        final net.minecraft.world.entity.npc.CatSpawner.SpawnAttempt attempt = this.catSpawnAttempt;
+        this.catSpawnAttempt = null;
+        if (attempt == null) return;
+        final Runnable close = () -> {
+            try {
+                attempt.close();
+            } catch (final Throwable failure) {
+                LOGGER.error("Failed to release cat spawning POI leases", failure);
+            }
+        };
+        // Taking ticket/scheduling locks inside a region callback inverts their lock order.
+        // Keep deferred cleanup on the world's existing queue so shutdown can drain it.
+        if (underRegionLock) this.world.taskQueueRegionData.pushGlobalChunkTask(close);
+        else close.run();
+    }
