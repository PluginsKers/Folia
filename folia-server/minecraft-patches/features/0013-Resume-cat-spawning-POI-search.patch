+    static void finishPendingCatSpawns(final ServerLevel world) {
+        world.regioniser.computeForAllRegionsUnsynchronised(region -> {
+            final RegionizedWorldData data = region.getData().getRegionizedData(world.worldRegionData);
+            if (data != null) data.cancelCatSpawn(false);
+        });
+        // Split/merge/destroy may already have detached an attempt under the region lock.
+        // Drain those deferred releases before halting the chunk system they reference.
+        while (world.taskQueueRegionData.hasGlobalChunkTasks()) {
+            try {
+                world.taskQueueRegionData.drainGlobalChunkTasks();
+            } catch (final Throwable failure) {
+                LOGGER.error("Failed to drain global chunk tasks before shutdown", failure);
+            }
+        }
+    }
+
